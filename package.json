{
  "name": "nest-desktop",
  "desktopName": "io.github.nest_desktop.nest-desktop",
  "version": "4.3.0b4",
  "private": false,
  "description": "NEST Desktop is a web-based GUI for the simulation of spiking neuronal networks.",
  "author": {
    "name": "Sebastian Spreizer",
    "email": "spreizer@web.de"
  },
  "scripts": {
    "app:build": "vue-tsc && vite build --outDir ./dist-electron && electron-builder",
    "app:dev": "vite",
    "app:preview:AppImage": "./out/nest-desktop-*.AppImage --no-sandbox --enable-unsafe-swiftshader",
    "build": "vue-tsc --noEmit && vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "clean": "rm -rf build coverage dist-electron nest_desktop.egg-info pydist release yarn-error.log",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --check src/",
    "format:write": "prettier --write src/",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/logo.svg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall:electron": "electron-builder install-app-deps",
    "preview": "vite preview",
    "preview:test": "vite preview --outDir ./coverage",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "~6.20.3",
    "@codemirror/lang-json": "~6.0.2",
    "@codemirror/lang-python": "~6.2.1",
    "@codemirror/lang-yaml": "~6.1.3",
    "@codemirror/state": "~6.7.6",
    "@codemirror/theme-one-dark": "~6.1.3",
    "@codemirror/view": "~6.43.13",
    "@mdi/font": "~7.4.47",
    "axios": "~1.20.0",
    "codemirror": "~6.0.2",
    "d3": "~7.9.0",
    "detect-browser": "~5.3.0",
    "events": "~3.3.0",
    "moment": "~2.31.0",
    "mustache": "~4.2.0",
    "object-hash": "~3.0.0",
    "pinia": "~4.0.3",
    "pinia-plugin-persistedstate": "~4.7.1",
    "plotly.js-cartesian-dist-min": "~4.1.2",
    "pouchdb": "~9.0.0",
    "pouchdb-upsert": "~2.2.0",
    "roboto-fontface": "^0.10.0",
    "stats.js": "~0.17.0",
    "three": "~0.186.1",
    "uuid": "~14.0.2",
    "vue": "~3.5.43",
    "vue-clipboard3": "~2.0.0",
    "vue-codemirror": "~6.1.1",
    "vue-router": "~5.3.1",
    "vuetify": "~4.2.3",
    "vuetify3-dialog": "~1.7.0",
    "webfontloader": "~1.6.28"
  },
  "devDependencies": {
    "@babel/types": "~8.0.6",
    "@tsconfig/node-lts": "~24.0.1",
    "@types/d3": "~7.4.3",
    "@types/js-yaml": "~4.0.9",
    "@types/mustache": "~4.2.6",
    "@types/node": "~26.6.4",
    "@types/object-hash": "~3.0.6",
    "@types/pouchdb": "~6.4.2",
    "@types/pouchdb-upsert": "~2.2.9",
    "@types/semver": "~7.8.0",
    "@types/three": "~0.186.0",
    "@types/webfontloader": "~1.6.38",
    "@vite-pwa/assets-generator": "~2.0.0",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/coverage-istanbul": "~5.0.3",
    "@vitest/coverage-v8": "~5.0.3",
    "@vitest/eslint-plugin": "~1.6.27",
    "@vitest/ui": "~5.0.3",
    "@vue/eslint-config-prettier": "~10.2.0",
    "@vue/eslint-config-typescript": "~14.9.0",
    "@vue/test-utils": "~2.5.1",
    "@vue/tsconfig": "~0.9.1",
    "electron": "~44.5.1",
    "electron-builder": "~26.15.3",
    "electron-devtools-installer": "~4.0.0",
    "eslint": "~10.12.0",
    "eslint-plugin-vue": "~10.11.1",
    "js-yaml": "~5.4.2",
    "prettier": "~3.9.9",
    "register-service-worker": "~1.7.2",
    "sass": "~1.105.1",
    "semver": "~7.8.5",
    "sharp": "~0.35.5",
    "tslog": "~5.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "unplugin-fonts": "~2.0.0",
    "vite": "~8.3.2",
    "vite-plugin-electron": "~1.1.2",
    "vite-plugin-pwa": "~2.0.0",
    "vite-plugin-vue-devtools": "~8.2.1",
    "vite-plugin-vuetify": "~2.1.3",
    "vitest": "~5.0.3",
    "vue-eslint-parser": "~10.4.1",
    "vue-tsc": "~3.3.12"
  },
  "//": [
    "# this section reserved for comments, c.f. https://groups.google.com/g/nodejs/c/NmL7jdeuw0M/m/yTqI05DRQrIJ -> notes on update problems with packages, etc.",
    "node: Use node LTS version (v24)",
    "typescript v7: vue-tsc throws error",
    "vite: The CJS build of Vite's Node API is deprecated. See https://vitejs.dev/guide/troubleshooting.html#vite-cjs-node-api-deprecated for more details."
  ],
  "bugs": {
    "url": "https://github.com/nest-desktop/nest-desktop/issues"
  },
  "contributors": [
    "Jens Bruchertseifer",
    "Sebastian Spreizer"
  ],
  "homepage": "https://nest-desktop.readthedocs.io",
  "keywords": [
    "NEST",
    "neuronal simulation",
    "computational neuroscience",
    "spiking neuronal networks",
    "biological neuronal networks"
  ],
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-desktop/nest-desktop"
  }
}
